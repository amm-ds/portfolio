# Copy to .env for local development (never commit .env). Production compose
# requires DOMAIN and IP_HASH_SALT; other values below are optional. There is no
# production mock provider: unconfigured Project 01 uses local Ollama, and the
# showcase RAG endpoints remain disabled unless RAG_CHAT_ENABLED=1.

# LLM provider (ADR-0004) — any OpenAI-compatible endpoint.
# Kimi/Moonshot example:
LLM_BASE_URL=https://api.moonshot.ai/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=kimi-k2-0711-preview
# Request timeout in seconds (optional)
LLM_TIMEOUT=60

# Kimi Code membership endpoint (OpenAI-compatible; models kimi-for-coding /
# -highspeed / k3 / k3-256k). Costs reported by the ledger are labelled
# cloud-equivalent estimates — the key is membership-quota, not pay-per-token.
# LLM_BASE_URL=https://api.kimi.com/coding/v1
# LLM_API_KEY=sk-your-membership-key-here
# LLM_MODEL=kimi-for-coding

# Equivalent LOCAL preset — LM Studio (or any OpenAI-compatible local server):
# the same hosted branch serves it, priced at $0 by the ledger's local rate
# card. Ollama works without any of this via the default branch.
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_API_KEY=lm-studio
# LLM_MODEL=local-model

# Budget guardrails (labelled cloud-equivalent caps enforced by the ledger)
# LLM_COST_LIMIT_USD=3.00        # per-process cap
# LLM_SUITE_COST_LIMIT_USD=2.00  # suite-run cap
# LLM_MAX_REQUESTS=400
# LLM_TOTAL_TOKENS_LIMIT=4000000

# Single-container deployment (see deploy/DEPLOY.md). VITE_* values are build
# arguments, not runtime secrets; BUILD_SHA and the remaining values are runtime.
# DOMAIN=portfolio.example.com
# IP_HASH_SALT=generate-a-long-random-value
# IMAGE=amm-ds-portfolio
# TAG=main
# BUILD_SHA=full-git-commit-sha
# VITE_SITE_URL=https://portfolio.example.com
# VITE_BUILD_SHA=full-git-commit-sha
# RATE_LIMIT_PER_MINUTE=30
# RAG_CHAT_ENABLED=
# FORWARDED_ALLOW_IPS=*  # only for the isolated compose network
