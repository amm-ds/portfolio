# Copy to .env (never commit .env). All values are optional; every project
# degrades to a deterministic mock/local mode when absent.

# LLM provider for Project 01 (RAG agent) — any OpenAI-compatible endpoint.
# Kimi/Moonshot example:
LLM_BASE_URL=https://api.moonshot.ai/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=kimi-k2-0711-preview
# Request timeout in seconds (optional)
LLM_TIMEOUT=60
