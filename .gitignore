# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
.coverage
htmlcov/
dist/
build/

# Data & artifacts (DVC-tracked, never committed raw)
data/
# ...except 08's raw bench record: the story's evidence commit preserves the
# full-grid run record (760 requests) alongside the aggregates so the published
# percentiles can be re-aggregated without re-running hours of local inference.
# (Git cannot re-include a file under an excluded dir, so this line documents
# the intent; the file is force-added like the 02 sidecar below.)
!projects/08-inference-serving/data/bench_run.json
*.parquet
# ...except the M5 demo sidecar: the demo payload copies the committed
# global model's catalog curves from it, so it is versioned like the
# data_m5/*.parquet subsets (force-add convention).
!projects/02-demand-forecasting/reports_m5/catalog_forecasts.parquet
*.csv
*.npy
*.npz
*.faiss
*.db
*.sqlite
models/
artifacts/
!**/data/.gitkeep

# Deployable artifacts — committed to git (small by policy) so a fresh clone /
# CI-built image serves a functional app without `dvc pull`. Bulky raw data
# stays DVC-tracked; the 01 RAG index is the one opt-in exception. See
# deploy/DEPLOY.md.
!projects/*/reports/models/
projects/*/reports/models/*
!projects/*/reports/models/serving/
!projects/*/reports/models/serving/**

# DVC
/.dvc/cache
/.dvc/tmp
/.dvc/config.local

# Secrets
.env
*.pem
*.key

# Node / web
node_modules/
apps/showcase-web/dist/

# OS / editor
.DS_Store
.idea/
.vscode/

# mkdocs output
/site/
