  "runtime_seconds": 2738.15,
  "determinism": "VECLIB_MAXIMUM_THREADS=1 pinned in cli.py before numpy; LightGBM n_jobs=1 + fixed seed + force_row_wise; statsforecast n_jobs=1; statsforecast models are closed-form/seed-free; the wave-29 pooled-global fits iterate sorted group keys and scatter forecasts by position \u2014 no set-order dependence",
  "metric_definitions": {
    "mae": "mean |actual - forecast| over the scored (series x day) cells",
    "wape": "sum |actual - forecast| / sum actual over the scored cells (pooled volume-weighted absolute percentage error)",
    "rmae": "candidate pooled MAE / seasonal_naive pooled MAE over the same cells (< 1 beats the naive floor); a zero naive MAE floors the ratio at 1.0",
    "wrmsse": "per (series x origin) unit: sqrt(MSE over the 28 scored days / in-sample MSE of the one-step seasonal-naive-28 over the series' training window); zero-denominator units excluded; 'wrmsse' = mean over units, 'wrmsse_weighted' = weighted by the training-window volume. NOTE: the official M5 denominator is the lag-1 random walk; this track uses the seasonal-naive-28 denominator per the wave-24 plan (a stricter scale for weekly-seasonal dense demand)",
    "peak_mae": "MAE on the window's top-decile-by-actual days (k = ceil(0.1*28) = 3)",
    "win_rate_vs_naive": "share of series whose pooled test |error| is below the seasonal_naive pooled test |error|",
    "pinball": "mean pinball loss at the stated quantile over the test cells",
    "coverage_80": "share of test actuals inside the per-series scaled split-conformal 80% band (pooled and by volume class)",
    "next_week_wape": "pooled WAPE over h=1..7 of EVERY rolling origin (each origin's first-week forecast is one deployed weekly forecast, so the 10 origins are 10 weekly service evaluations rolled together) \u2014 the rolling next-week service number; reported pooled, per volume class, and with the paired cluster-bootstrap gap vs seasonal_naive",
    "weekly_block_wape": "pooled WAPE per 7-day block of the 28-day horizon (wk1 = h1-7, wk2 = h8-14, wk3 = h15-21, wk4 = h22-28) over the 2 scored-once test origins \u2014 the honest error-growth shape of the month-ahead view",
    "bias": "mean(forecast - actual) / mean(actual) over the scored cells \u2014 the pooled relative over/under-forecast (positive = over-forecast); NaN when the scored volume is 0",
    "stability": "population std (ddof=0) of the per-origin pooled WAPE across the 8 selection origins \u2014 how steadily a candidate scores origin to origin, selection data only",
    "zero_day_accuracy": "share of scored points with actual == 0 whose forecast is < 0.5 (a 'quiet-day hit'); NaN when the scored block has no zero-actual points \u2014 reported pooled and for the intermittent class",
    "ensemble_screen": "wave-30 ensemble criterion: mean + 1.0 x population std of the per-origin pooled metric (WAPE for convex_ensemble, WRMSSE for ensemble_l2) across the 8 selection origins; ranks the pool AND fits the simplex weights (blend values computed exactly from the forecast-level convex combination, not from member metric summaries). Motivation: the M5 literature's advice to weigh fold-to-fold stability alongside average accuracy \u2014 the wave-29 mean-only (pooled) rule picked a blend +0.0048 test WAPE worse than wave 28"
  },
