  "metric_definitions": {
    "official_wrmsse": "official M5 hierarchical WRMSSE: bottom forecasts aggregate bottom-up through all 12 levels (42,840 nodes on the real panel); per-node RMSSE = sqrt(mean squared error over the 28 scored days / mean squared first difference of the node's TRAIN window); node weight = revenue (units x sell_price) over the 28 days preceding the scored window, aggregated bottom-up and normalized across all nodes (equal total per level \u2014 the official scheme); zero-denominator nodes excluded with renormalization (counted)",
    "bottom_wape": "pooled WAPE over the 30,490 bottom series' scored cells: sum |err| / sum actual",
    "bias": "mean(forecast - actual) / mean(actual) over the bottom scored cells (positive = over-forecast); NaN when the scored volume is 0",
    "stability": "population std (ddof=0) of the per-origin official WRMSSE across the selection origins",
    "zero_day_accuracy": "share of bottom scored points with actual == 0 whose forecast is < 0.5 \u2014 pooled and for the intermittent ADI/CV\u00b2 class; NaN when the block has no zero-actual points",
    "ensemble_screen": "mean + 1.0 x population std of the per-origin official WRMSSE across the selection origins, computed exactly from the forecast-level convex blend re-aggregated through the hierarchy"
  }
