# Copy to .env to override defaults. All settings use the AGENT_CHAT_ prefix.

# --- model provider ---
# ollama (default), hosted (OpenAI-compatible), or kimi.
AGENT_CHAT_PROVIDER=ollama
AGENT_CHAT_OLLAMA_BASE_URL=http://localhost:11434
AGENT_CHAT_OLLAMA_MODEL=qwen3:8b
AGENT_CHAT_OLLAMA_FALLBACK_MODEL=
# Generic hosted provider (set AGENT_CHAT_PROVIDER=hosted):
AGENT_CHAT_HOSTED_BASE_URL=
AGENT_CHAT_HOSTED_API_KEY=
AGENT_CHAT_HOSTED_MODEL=
AGENT_CHAT_HOSTED_FALLBACK_MODEL=
# Kimi Code OpenAI-compatible API (set AGENT_CHAT_PROVIDER=kimi).
# Keep the real key only in your untracked local .env or secret manager.
AGENT_CHAT_KIMI_BASE_URL=https://api.kimi.com/coding/v1
AGENT_CHAT_KIMI_API_KEY=
AGENT_CHAT_KIMI_MODEL=k3-256k
AGENT_CHAT_KIMI_FALLBACK_MODEL=
AGENT_CHAT_MODEL_RETRIES=2
# Bounded executor for synchronous agent callbacks; closed on API shutdown.
AGENT_CHAT_EXECUTOR_WORKERS=4

# --- per-run usage budgets (0 = unlimited) ---
AGENT_CHAT_USAGE_REQUEST_LIMIT=30
AGENT_CHAT_USAGE_INPUT_TOKENS_LIMIT=100000
AGENT_CHAT_USAGE_OUTPUT_TOKENS_LIMIT=20000

# --- storage: sqlite file by default; docker compose points this at Postgres ---
AGENT_CHAT_DATABASE_URL=sqlite:///./agent_chat.db
# One <session_id>.json notebook per browser session; recalled on demand only.
AGENT_CHAT_MEMORY_DATA_DIR=./agent_chat_memory

# --- conversation history ---
# Keep this many user turns. Summarization is opt-in and runs only on overflow.
AGENT_CHAT_HISTORY_MAX_TURNS=10
AGENT_CHAT_HISTORY_SUMMARIZE_ENABLED=false

# --- embeddings: minilm (default, needs `uv sync --extra embeddings`) or hashing ---
AGENT_CHAT_EMBEDDER=minilm
AGENT_CHAT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- api ---
# Set to require the X-API-Key header on /chat, /ingest, /approvals, DELETEs.
AGENT_CHAT_API_KEY=
# Seconds to wait for a human approval decision before default-deny.
AGENT_CHAT_APPROVAL_TIMEOUT_S=120
# Opt-in network access for the fetch_url tool.
AGENT_CHAT_FETCH_URL_ENABLED=false
