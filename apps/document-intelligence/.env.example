# Local defaults use deterministic analysis and in-memory repositories.
DOCUMENT_INTELLIGENCE_ENVIRONMENT=development
DOCUMENT_INTELLIGENCE_IDENTITY_MODE=development
DOCUMENT_INTELLIGENCE_REPOSITORY_BACKEND=memory
DOCUMENT_INTELLIGENCE_BLOB_BACKEND=local
DOCUMENT_INTELLIGENCE_BLOB_DIR=./var/blobs
DOCUMENT_INTELLIGENCE_ANALYZER_BACKEND=fixture

# Production-shaped stack (also see infra/docker-compose.yml).
# DOCUMENT_INTELLIGENCE_DATABASE_URL=postgresql+psycopg://review:review@localhost:5432/review
# DOCUMENT_INTELLIGENCE_REPOSITORY_BACKEND=postgres
# DOCUMENT_INTELLIGENCE_IDENTITY_MODE=gateway
# DOCUMENT_INTELLIGENCE_ENVIRONMENT=production
# DOCUMENT_INTELLIGENCE_GATEWAY_SHARED_SECRET=replace-through-your-secret-manager

# Kimi or another OpenAI-compatible structured-output provider.
# DOCUMENT_INTELLIGENCE_ANALYZER_BACKEND=model
# DOCUMENT_INTELLIGENCE_PROVIDER=kimi
# DOCUMENT_INTELLIGENCE_MODEL_NAME=kimi-k2.5
# DOCUMENT_INTELLIGENCE_MODEL_BASE_URL=https://api.moonshot.ai/v1
# DOCUMENT_INTELLIGENCE_MODEL_API_KEY=replace-through-your-secret-manager
# DOCUMENT_INTELLIGENCE_MODEL_RETRIES=2
# DOCUMENT_INTELLIGENCE_MODEL_TIMEOUT_SECONDS=180
# DOCUMENT_INTELLIGENCE_MODEL_TOTAL_TOKENS_LIMIT=32000
# DOCUMENT_INTELLIGENCE_MODEL_CHAT_TOKENS_LIMIT=8000

# Page pipeline limits.
# DOCUMENT_INTELLIGENCE_PAGE_CONCURRENCY=3
# DOCUMENT_INTELLIGENCE_PAGE_TEXT_MAX_CHARS=24000
# DOCUMENT_INTELLIGENCE_MAX_UPLOAD_BYTES=10000000

# Worker lease and retry knobs (Postgres worker; see specs/operations.md).
# DOCUMENT_INTELLIGENCE_LEASE_SECONDS=60
# DOCUMENT_INTELLIGENCE_HEARTBEAT_SECONDS=20
# DOCUMENT_INTELLIGENCE_MAX_JOB_ATTEMPTS=3
# DOCUMENT_INTELLIGENCE_WORKER_POLL_SECONDS=1

# Optional S3-compatible blob storage; credentials use the AWS provider chain.
# DOCUMENT_INTELLIGENCE_BLOB_BACKEND=s3
# DOCUMENT_INTELLIGENCE_S3_BUCKET=your-bucket
# DOCUMENT_INTELLIGENCE_S3_PREFIX=documents
# DOCUMENT_INTELLIGENCE_S3_ENDPOINT_URL=
# DOCUMENT_INTELLIGENCE_S3_REGION=
