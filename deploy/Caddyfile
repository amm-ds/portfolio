# Caddy reverse proxy — automatic public TLS for the configured DOMAIN.
# DOMAIN and ACME_EMAIL are required by docker-compose.prod.yml; Caddy
# terminates TLS and is the only published service. Keep the API private so
# forwarding headers can only arrive through this proxy.

{
    # ACME account email (ACME_EMAIL): the CA sends certificate expiry and
    # problem advisories to this address. Required by the compose env — there
    # is intentionally no default: an unset email fails `caddy validate`.
    email {$ACME_EMAIL}
}

{$DOMAIN} {
    encode zstd gzip

    # Security headers
    header {
        # HSTS for 1 year incl. subdomains. `preload` is a conscious opt-out:
        # it requires submitting the domain to the browser preload list, which
        # is hard to undo, so it stays off until deliberately enabled.
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        # Full process isolation from cross-origin popups/windows (defense in
        # depth next to frame-ancestors 'none' / X-Frame-Options DENY).
        Cross-Origin-Opener-Policy "same-origin"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Permissions-Policy "geolocation=(), camera=(), microphone=()"
        -Server
    }

    # Exactly one CSP applies per response. Keeping the strict SPA policy in the
    # global block would also apply it to the exceptions below, so their inline
    # bootstraps would still be blocked by the browser.
    @strict {
        path /*
        not path /projects/*/report /projects/*/figures/* /docs* /redoc*
    }
    # Renderer-injected inline styles and data: images/fonts are expected;
    # scripts stay same-origin on the SPA.
    header @strict Content-Security-Policy "default-src 'self'; script-src 'self'; img-src 'self' data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'"

    # Trusted generated reports/figures execute their own inline bootstrap and
    # load pinned-major renderer assets. This exception is route-scoped: the SPA
    # keeps the stricter same-origin script policy above. The report SPA route
    # needs the same exception because its sandboxed srcDoc inherits parent CSP.
    header /projects/*/report Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.plot.ly https://cdn.jsdelivr.net; img-src 'self' data:; font-src 'self' data:; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'"
    header /projects/*/figures/* Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.plot.ly https://cdn.jsdelivr.net; img-src 'self' data:; font-src 'self' data:; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'"
    header /docs* Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'"
    header /redoc* Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; img-src 'self' data:; font-src 'self' data:; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'"

    reverse_proxy api:8000
}
